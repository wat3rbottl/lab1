@startuml
skinparam classAttributeIconSize 0
title Refaktoriseringsplan

' =========================
' Core interfaces
' =========================
interface Movable {
  + move() : void
  + turnRight() : void
  + turnLeft() : void
}

interface Loadable{
  - isLoaded() : boolean
}

interface Loader{
  + load(item) : void
  + unload()
}

interface Transportable extends Loadable {
  + getPosition() : Position
  + setPosition(p: Position)
}

interface Transporter extends Loader {
  + updateLoadedPositions()
}

interface Turboable {
  + setTurboOn()
  + setTurboOff()
}

interface Ramp {
   - atMax : boolean
   - atMin : boolean
   + lower(deg) : void
   + lift(deg) : void
   + canLoad() : boolean
}

' =========================
' Decomposition: Vehicle parts
' =========================
class Position {
  - x : double
  - y : double
  + getX() : double
  + getY() : double
  + setX(x: double)
  + setY(y: double)
}

class Engine {
  - started : boolean
  - enginePower : double
  - currentSpeed : double
  + start()
  + stop()
  + isStarted() : boolean
  + getCurrentSpeed() : double
  + setCurrentSpeed(v: double)
}

class SpeedModel {
  + speedFactor() : double
  + incrementSpeed(engine: Engine, amount: double)
  + decrementSpeed(engine: Engine, amount: double)
}

enum Direction {
  NORTH
  SOUTH
  EAST
  WEST
}

' =========================
' Domain model
' =========================
abstract class Vehicle implements Movable{
  - position : Position
  - engine : Engine
  - speedModel : SpeedModel
  - direction : Direction
  + getPosition() : Position
  + setPosition(p: Position)
  + getDirection() : Direction
  + setDirection(d: Direction)
  + startEngine()
  + stopEngine()
  + gas(amount: double)
  + brake(amount: double)
  + move()
}

abstract class Car extends Vehicle implements Transportable, Transporter

class Volvo240 extends Car
class Saab95 extends Car implements Turboable

' Transporters
abstract class CarTransporter extends Vehicle implements Transporter
class Scania extends Vehicle implements Ramp, Transporter
class CarFerry extends CarTransporter
class VolkswagenUnicorn extends CarTransporter implements Ramp

class RepairShop implements Loader

class LaneManager {
  + addToQueue(item)
  + removeFromQueue()
  + size() : int
}

' =========================
' Simulation & rules
' =========================
class Simulation {
  - vehicles : List
  - transporters : List
  - repairShop : RepairShop
  - wallHandler : WallCollisionHandler
  + tick()
}

class WallCollisionHandler {
  + handle(vehicle: Vehicle, bounds: Rectangle)
}

' =========================
' GUI / MVC refactor
' =========================
class CarController {
  - simulation : Simulation
  - input : InputHandler
  - view : CarView
  + Gas(amount:int)
  + Brake(amount:int)
  + StartAll()
  + StopAll()
  + TurnLeft()
  + TurnRight()
  + Up()
  + Down()
  + TurboOn()
  + TurboOff()
}

class InputHandler {
  - controller : CarController
  + bindKeyboard(component: JComponent)
  + bindButtons(view: CarView)
}

class ImageHandler {
  + getImageKey(Obj : object) : String
  + isFlipped(Obj : object) : boolean
}

class DrawPanel {
  - images : ImageHandler
  - vehicles : List
  + setVehicles(vehicles: List)
  + paintComponent(g: Graphics)
}

class CarView

' =========================
' Relationships
' =========================

' Composition of Vehicle
Vehicle *-- Position
Vehicle *-- Engine
Vehicle *-- SpeedModel
Vehicle --> Direction

' Inheritance
Vehicle <|-- Car
Car <|-- Volvo240
Car <|-- Saab95
Vehicle <|-- CarTransporter
CarTransporter <|-- VolkswagenUnicorn
CarTransporter <|-- CarFerry
Vehicle <|-- Scania

' Realizations
CarTransporter ..|> Transporter
RepairShop ..|> Loader
Saab95 ..|> Turboable
Scania ..|> Ramp
VolkswagenUnicorn ..|> Ramp

' Ferry uses LaneManager
CarFerry --> LaneManager : lanes

' Simulation owns rule handler and aggregates world objects
Simulation --> WallCollisionHandler
Simulation o-- Vehicle : vehicles
Simulation o-- VehicleTransporter : transporters
Simulation --> RepairShop : repairShop

' GUI
JFrame <|-- CarView
JPanel <|-- DrawPanel

CarController --> Simulation
CarController --> CarView
CarController --> InputHandler

InputHandler --> CarController

DrawPanel --> ImageHandler
DrawPanel ..> Transportable : renders list

CarView --> DrawPanel

@enduml
